# Alle Werte sind optional – ohne .env laufen die Standardwerte.
# Kopiere diese Datei nach .env und passe an, was du brauchst.

# ----- Image -----
# Fertiges Image (Standard) oder dein eigenes:
# JF_HUB_IMAGE=ghcr.io/volltext/jf-hub:latest

# ----- Erreichbarkeit -----
# Standard: nur auf diesem Rechner (127.0.0.1). Für das Heimnetz: 0.0.0.0
BIND=127.0.0.1
HOST_PORT=8080
TZ=Europe/Berlin

# ----- Daten -----
# Ordner für die Datenbank. Standard: benanntes Docker-Volume.
# Auf ZimaOS nimmst du stattdessen die fertige docker-compose.zimaos.yml (docs/installation.md, Variante D).
# DATA_PATH=jf-hub-data

# ----- Erstes Admin-Konto -----
# Leer lassen: Setup-Code im Log, Konto im Browser unter /admin/ anlegen (empfohlen).
# Oder hier Benutzername + Passwort (mind. 10 Zeichen) für den allerersten Start setzen.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Auf 1 setzen, um das Passwort von ADMIN_USER mit ADMIN_PASSWORD zu überschreiben (danach wieder 0).
ADMIN_PASSWORD_RESET=0

# ----- Benachrichtigungen (Web-Push) -----
# Kontaktadresse für den Push-Dienst der Browser. Bitte eine eigene E-Mail-Adresse eintragen.
PUSH_SUBJECT=mailto:admin@example.com

# ----- E-Mail (optional, docs/e-mail.md) -----
# Betreuer können ihr Postfach (GMX, WEB.DE, ...) einbinden. Ohne Angaben läuft alles mit Standardwerten.
# Auf 0 setzen, um E-Mail auf dem ganzen Server abzuschalten.
# MAIL_ENABLED=1
# Schlüssel für die gespeicherten Passwörter: 64 Hex-Zeichen (openssl rand -hex 32). Leer = Datei mail.key im Datenordner.
# Den Schlüssel getrennt vom Backup aufheben.
# MAIL_KEY=
# Mail-Server in privaten Netzen erlauben (eigener Server im Heimnetz). Standard: nur öffentliche Adressen.
# MAIL_ALLOW_PRIVATE=0
# Abstand der Prüfung auf neue Mails in Sekunden (mindestens 30).
# MAIL_POLL_SECONDS=120

# ----- Reverse-Proxy -----
# Welchen Proxys X-Forwarded-For geglaubt wird. Leer = nur Proxys in privaten Netzen (richtig für Cloudflare Tunnel,
# Caddy, Traefik, Nginx Proxy Manager im selben Docker-Netz). "true" = jedem (nur wenn der Server nie direkt erreichbar ist!).
# TRUST_PROXY=

# ----- Demo-Instanz (docs/demo.md) -----
# ACHTUNG: DEMO=1 löscht beim Start und täglich um DEMO_RESET_AT ALLE Daten und legt Beispieldaten an.
# Nur für eine eigene, öffentliche Probier-Instanz – nie auf dem echten Server der Jugendfeuerwehr.
# DEMO=0
# DEMO_RESET_AT=03:00

# ----- Cloudflare Tunnel (Profil "tunnel") -----
# Token aus dem Zero-Trust-Dashboard: Networks → Tunnels → dein Tunnel → Docker
TUNNEL_TOKEN=

# ----- Eigene Domain mit Caddy (docker-compose.caddy.yml) -----
# DOMAIN=jfhub.example.org
